# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

# HTTP port (lab default 3010)
PORT=3010

# Allowed browser origin for CORS (e.g. Vite or CRA dev server). Omit to reflect any Origin in development.
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# Max CV upload size in bytes (default 10 MiB if unset)
# MAX_CV_BYTES=10485760

# Directory for stored CV files (absolute path, or relative to process cwd). Default: uploads/cvs
# CV_UPLOAD_DIR=uploads/cvs
